# Скопируйте этот файл в .env и вставьте свои ключи.
# Заполненные ключи определяют, какие агенты реально работают.
# Агент без ключа вернёт ошибку — приложение покажет её в журнале.

MOONSHOT_API_KEY=       # platform.moonshot.ai      — КОРД (директор)
PERPLEXITY_API_KEY=     # perplexity.ai/settings/api — СКАУТ (веб-разведчик)
OPENAI_API_KEY=         # platform.openai.com       — ИСКАТЕЛЬ, АРХИТЕКТОР, ИНЖЕНЕР
ANTHROPIC_API_KEY=      # console.anthropic.com     — ВЕСТА, РЕДАКТОР
GEMINI_API_KEY=         # aistudio.google.com       — АВТОР
DEEPSEEK_API_KEY=       # platform.deepseek.com     — РЕЦЕНЗЕНТ
OPENROUTER_API_KEY=     # openrouter.ai             — РЕЛИЗ
